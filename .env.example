APP_ENV=development

# Required for higher GitHub rate limits. Public unauthenticated requests work for small demos.
GITHUB_TOKEN=

# Optional. Enables creating documentation branches and pull requests.
# Use a fine-grained token with Contents and Pull requests read/write access.
GITHUB_WRITE_TOKEN=

# Optional. Enables LLM clustering instead of heuristic clustering.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional NVIDIA semantic retrieval and reranking. Disabled preserves keyword search.
NVIDIA_API_KEY=
NVIDIA_EMBED_ENABLED=false
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_URL=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_EMBED_MAX_PASSAGES=2048
NVIDIA_EMBED_TIMEOUT_SECONDS=120
NVIDIA_RERANK_ENABLED=false
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking
NVIDIA_RERANK_CANDIDATES=40
NVIDIA_RERANK_TIMEOUT_SECONDS=15
